{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "exclude": ["tests/**/*.tsx"],
  "include": [
    "src/main",
    "src/preload",
    "src/core",
    "src/app",
    "src/adapters",
    "src/shared",
    "src/diff.d.ts",
    "src/dev",
    "tests",
    "vite.browser.config.ts",
    "electron.vite.config.ts",
    "electron-builder.config.ts",
    "vitest.config.ts"
  ]
}
