{
  "name": "esteira",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "App de desktop para confrontar user stories com código, wiki e backlog do Azure DevOps.",
  "author": "Esteira",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.browser.config.ts --host 127.0.0.1 --port 43123 --strictPort",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "scan-secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@napi-rs/keyring": "^1.1.6",
    "azure-devops-node-api": "^14.1.0",
    "diff": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.esteira.desktop",
    "productName": "Esteira",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@napi-rs/keyring/**",
      "**/node_modules/@napi-rs/keyring-*/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "node_modules/@napi-rs/keyring/**",
      "node_modules/@napi-rs/keyring-*/**"
    ],
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Esteira",
      "uninstallDisplayName": "Esteira",
      "installerLanguages": [
        "pt_BR",
        "en_US"
      ]
    }
  }
}
